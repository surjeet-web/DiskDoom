PRODUCT_BUNDLE_IDENTIFIER = com.diskdoom.DiskDoom.debug
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
SWIFT_STRICT_CONCURRENCY = complete
MACOSX_DEPLOYMENT_TARGET = 13.0
PRODUCT_NAME = DiskDoom

// Build every configuration as a universal binary. Debug used to inherit
// ONLY_ACTIVE_ARCH=YES, so a build made on an Intel Mac shipped x86_64-only
// and failed to launch natively on Apple Silicon.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// Ship metadata (Info.plist keys via build settings).
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_NSSupportsAutomaticTermination = NO
INFOPLIST_KEY_NSSupportsSuddenTermination = NO

// NOTE: INFOPLIST_FILE deliberately lives in the app target's build settings,
// not here. This xcconfig is attached at the *project* level, so anything in
// it is inherited by every target — and INFOPLIST_FILE here caused the UI
// test runner app to be built with the main app's Info.plist (wrong
// CFBundleIdentifier), which made DiskBuddyUITests fail to dlopen with
// "different Team IDs". Only the app needs a custom Info.plist.
