PRODUCT_BUNDLE_IDENTIFIER = com.diskdoom.DiskDoom
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
SWIFT_STRICT_CONCURRENCY = complete
MACOSX_DEPLOYMENT_TARGET = 13.0
PRODUCT_NAME = DiskDoom

// Universal binary: Apple Silicon + Intel.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// Ship metadata (Info.plist keys via build settings).
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_NSSupportsAutomaticTermination = NO
INFOPLIST_KEY_NSSupportsSuddenTermination = NO
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright 2026 DiskDoom. All rights reserved.

// INFOPLIST_FILE is set on the app target only — see Debug.xcconfig.
